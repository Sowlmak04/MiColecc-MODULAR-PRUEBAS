{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "micolecc-modular-pruebas",
  "main": "./worker.js",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mi-coleccion-db",
      "database_id": "6fea2856-a4d0-4987-b449-4c6164789378"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "mi-coleccion-images"
    }
  ]
}
